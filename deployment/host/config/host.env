# 이 파일은 Bash 설정입니다. 경로는 start_host.sh의 위치에서 자동 계산합니다.
# 개별 실행에서 HOST_ROS_DOMAIN_ID=149 등으로 임시 변경할 수 있습니다.
HOST_ROS_DOMAIN_ID="${HOST_ROS_DOMAIN_ID:-40}"
HOST_DISCOVERY_RANGE="${HOST_DISCOVERY_RANGE:-SUBNET}"
HOST_RMW_IMPLEMENTATION="${HOST_RMW_IMPLEMENTATION:-rmw_fastrtps_cpp}"
# 이동 명령 속도는 로봇 설정 최대속도의 백분율입니다.
export HOST_SPEED_PERCENT="${HOST_SPEED_PERCENT:-100}"
export HOST_GOAL_TIMEOUT="${HOST_GOAL_TIMEOUT:-5}"
export HOST_MOTION_TIMEOUT="${HOST_MOTION_TIMEOUT:-300}"
export HOST_ARM_TIMEOUT="${HOST_ARM_TIMEOUT:-600}"
